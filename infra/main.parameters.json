{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME=dev}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "deploySpoke": {
      "value": "${AI_PLATFORM_DEPLOY_SPOKE=true}"
    },
    "deployAppLayer": {
      "value": "${AI_PLATFORM_DEPLOY_APP_LAYER=true}"
    },
    "deployHub": {
      "value": "${AI_PLATFORM_DEPLOY_HUB=true}"
    }
  }
}
